rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the shared keepsake account, signed in with the passcode, can read or change anything.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "password"
        && request.auth.token.email == "keepsake@example.com";
    }
  }
}
